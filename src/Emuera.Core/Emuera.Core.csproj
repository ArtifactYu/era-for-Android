<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MinorShift.Emuera</RootNamespace>
    <AssemblyName>Emuera.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- 上流ソースの警告は移植作業のノイズになるので抑制する -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0414;CS1591</NoWarn>
    <UpstreamDir>$(MSBuildThisFileDirectory)..\..\upstream\emuera.em\Emuera\</UpstreamDir>
  </PropertyGroup>

  <!--
    上流 (upstream/emuera.em) のソースを「コピーせずリンク参照」する。
    こうすることで git pull による上流追従が差分ゼロで済み、
    Android で成立しないファイルだけをここで Remove して自前実装に差し替える。
  -->
  <ItemGroup>
    <Compile Include="$(UpstreamDir)Runtime\**\*.cs" LinkBase="upstream\Runtime" />
    <Compile Include="$(UpstreamDir)UI\**\*.cs" LinkBase="upstream\UI" />
    <Compile Include="$(UpstreamDir)GlobalStatic.cs" LinkBase="upstream" />
  </ItemGroup>

  <!-- Android で成立しないため除外するもの -->
  <ItemGroup>
    <!-- WinForms のウィンドウ・ダイアログ一式。Android 側 UI で置き換える -->
    <Compile Remove="$(UpstreamDir)UI\Framework\**\*.cs" />
    <!-- 辞書ポップアップ (Rikaichan)。PC 専用機能なので当面対象外 -->
    <Compile Remove="$(UpstreamDir)UI\Game\Rikaichan.cs" />
    <Compile Remove="$(UpstreamDir)UI\Game\RikaichanAutogenerated.cs" />
    <!-- 音声バックエンド。Android MediaPlayer 実装に差し替える -->
    <Compile Remove="$(UpstreamDir)Runtime\Utils\Sound.WMP.cs" />
    <Compile Remove="$(UpstreamDir)Runtime\Utils\Sound.NAudio.cs" />
    <Compile Remove="$(UpstreamDir)Runtime\Utils\NAudio_LoopStream.cs" />
    <!-- libwebp の P/Invoke。SkiaSharp のデコーダに差し替える -->
    <Compile Remove="$(UpstreamDir)Runtime\Utils\WebPWrapper.cs" />
    <!-- Win32 API 直呼び -->
    <Compile Remove="$(UpstreamDir)Runtime\Utils\WinmmTimer.cs" />
    <Compile Remove="$(UpstreamDir)Runtime\Utils\WinInput.cs" />
    <!-- XInput の P/Invoke。Android には無い。呼び出し側 (UI\Framework) も除外済み -->
    <Compile Remove="$(UpstreamDir)Runtime\Utils\GamePad.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(UpstreamDir)Properties\lang\emuera-eng.xml" Link="Properties\lang\emuera-eng.xml" />
    <EmbeddedResource Include="$(UpstreamDir)Properties\lang\emuera-zhs.xml" Link="Properties\lang\emuera-zhs.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Enums.NET" Version="4.0.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <!-- 統合パッチで入った HASH_XXH3 / HASH_XXH32 用 -->
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
    <!-- 同じく SQL_* 用。bundle_e_sqlite3 が Android のネイティブ SQLite を持ってくる -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
