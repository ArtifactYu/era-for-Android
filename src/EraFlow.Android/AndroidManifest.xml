<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <!-- 外部目录直读：Android 12 及以下用旧存储权限，Android 13+ 走 MANAGE_EXTERNAL_STORAGE -->
 <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
 <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
 <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
 <application android:allowBackup="false" android:icon="@drawable/appicon" android:label="era for Android" android:usesCleartextTraffic="true" android:hardwareAccelerated="true" android:supportsRtl="true" android:requestLegacyExternalStorage="true"/>
</manifest>
