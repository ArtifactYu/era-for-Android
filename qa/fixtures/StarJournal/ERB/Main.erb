@SYSTEM_TITLE
CALL JOURNAL

@EVENTLOAD
CALL JOURNAL

@JOURNAL
$MENU
DRAWLINE
PRINTL 星间驿站 / STAR JOURNAL
PRINT_IMG "SCENE"
PRINTL
PRINTL 舷窗外，一颗绿色的行星缓缓升起。
PRINTFORML 航行记录：{FLAG:0} 天
PRINTBUTTON "[0] 继续航行  ", 0
PRINTBUTTON "[1] 保存  ", 1
PRINTBUTTON "[2] 读取  ", 2
PRINTBUTTON "[3] 重置", 3
PRINTL
INPUT
SELECTCASE RESULT
CASE 0
 FLAG:0 += 1
CASE 1
 SAVEDATA 0, "星间驿站"
 PRINTL 已保存
CASE 2
 LOADDATA 0
CASE 3
 FLAG:0 = 0
ENDSELECT
GOTO MENU
