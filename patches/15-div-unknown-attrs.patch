.netEmuera は HTML パーサ(AngleSharp)なので解釈しない属性名を素通しする。
そのため綴りの間違いがゲーム側に残ったまま配布されていることがある。
ShinEraTenseiP の FORMATION.ERB:499 が <div xpos='0' yos='0'> になっており、
依頼を受けた先の隊列表示でエラー停止していた。
---
 Emuera/UI/Game/HtmlManager.cs | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/Emuera/UI/Game/HtmlManager.cs b/Emuera/UI/Game/HtmlManager.cs
index d01358d..c3d95aa 100644
--- a/Emuera/UI/Game/HtmlManager.cs
+++ b/Emuera/UI/Game/HtmlManager.cs
@@ -1234,7 +1234,12 @@ internal static class HtmlManager
 							else throw new CodeEE(string.Format(trerror.CanNotInterpretAttribute.Text, attrValue));
 						}
 						else if (!TryParseStyledBoxModel(ref box, tag, word.Code, attrValue))
-							throw new CodeEE(string.Format(trerror.CanNotInterpretAttributeName.Text, tag, word.Code));
+						{
+							//統合_netEmuera: 知らない属性は読み飛ばす。
+							//.netEmuera は HTML パーサ(AngleSharp)なので、解釈しない属性名は素通しする。
+							//そのため綴りの間違いがゲーム側に残ったまま配布されている
+							//（ShinEraTenseiP の FORMATION.ERB:499 に <div xpos='0' yos='0'>）
+						}
 					}
 					//統合_netEmuera: width/height 省略時は中身に合わせる（null のまま渡す）
 					state.PendingDivTag = new HtmlDivTag(x, y, width, height, depth, color, box, displayMode);
