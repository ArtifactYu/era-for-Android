+﻿//統合_ゲームパッド対応: パッドを一定間隔で読んで、選択カーソルの移動と決定に割り当てる。
 //決定はマウスクリックと同じ経路（PressEnterKey の inputsByMouse）に流すので、
 //ERB 側から見た挙動はボタンをクリックしたときと同じになる。
+using MinorShift.Emuera.GameView;
 using MinorShift.Emuera.Runtime.Config.JSON;
 using MinorShift.Emuera.Runtime.Utils;
 using System;
@@ -57,9 +58,11 @@ namespace MinorShift.Emuera.Forms
 				return;
 			}
 
-			//左右も前後移動に使う。era系の選択肢は縦横どちらにも並ぶため
-			if ((pressed & (cfg.Up | cfg.Left)) != 0) { console.MoveSelectingButton(-1); return; }
-			if ((pressed & (cfg.Down | cfg.Right)) != 0) { console.MoveSelectingButton(1); return; }
+			//左右は行内の隣へ、上下は上/下の行の近い位置へ
