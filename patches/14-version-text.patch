EM+EE と .netEmuera の統合版なので、どちらの名前でもない独自の名前にする。
統合レイヤの版として EXv1 を足し、git のコミットハッシュは付けない
（画面右上に収まらず切れていたため）。
---
 Emuera/Emuera.csproj        | 8 ++++----
 Emuera/Runtime/Utils/Sys.cs | 3 ++-
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/Emuera/Emuera.csproj b/Emuera/Emuera.csproj
index f02388d..2070a81 100644
--- a/Emuera/Emuera.csproj
+++ b/Emuera/Emuera.csproj
@@ -21,7 +21,8 @@
         <RootNamespace>MinorShift.Emuera</RootNamespace>
         <ApplicationManifest>emuera.manifest</ApplicationManifest>
         <Version>1.824.0</Version>
-        <InformationalVersion>1.824+v24+EMv18+EEv56</InformationalVersion>
+        <!-- 統合: ベース(EM+EE)の版に、統合レイヤの版 EXvN を足す。パッチを増やしたら上げる -->
+        <InformationalVersion>1.824+v24+EMv18+EEv56+EXv13</InformationalVersion>
         <Copyright>Copyright (C) 2008- MinorShift, 妊）|дﾟ)の中の人</Copyright>
     </PropertyGroup>
 
@@ -35,9 +36,8 @@
         <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
         <TieredCompilation>true</TieredCompilation>
         <ServerGarbageCollection>true</ServerGarbageCollection>
-      <!--
-        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
-        -->
+      <!-- 統合: 版表記に git のコミットハッシュを足さない（画面右上に収まらないため） -->
+      <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
     </PropertyGroup>
 
     <Choose>
diff --git a/Emuera/Runtime/Utils/Sys.cs b/Emuera/Runtime/Utils/Sys.cs
index a9dad6a..e1e042e 100644
--- a/Emuera/Runtime/Utils/Sys.cs
+++ b/Emuera/Runtime/Utils/Sys.cs
@@ -16,7 +16,8 @@ public static class AssemblyData
 		ExeName = Path.GetFileName(ExePath);
 		emueraVer = typeof(AssemblyData).Assembly.GetName().Version;
 
-		EmueraVersionText = "Emuera.NET " + Application.ProductVersion;
+		//統合: EM+EE と .netEmuera の統合版なので、どちらの名前でもない独自の名前を出す
+		EmueraVersionText = "EmueraEX " + Application.ProductVersion;
 	}
 
 	/// <summary>
-- 
