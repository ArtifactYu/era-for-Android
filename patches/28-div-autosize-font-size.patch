大きさを書いていない div は中身の実寸までクリップを広げる（パッチ22）が、
その実寸を出す ContentBottom が AConsoleDisplayPart.Bottom を見ており、
これは <font size> によらず設定フォントサイズを返す。このため
<font size='300'> の文字を入れた div は行高ぶんで切られ、文字の上だけが出ていた。

ShinEraTenseiP の RPG\ダンジョンアタック\SYSTEM_DUNGEON.ERB:2630 の
ENCOUNT 表示が大きさ省略の div に 300% の文字を入れる形なので、
そこだけ ConsoleStyledString の指定サイズを見るようにする。

Bottom そのものは変えない。ConsoleButtonString.FilterEscaped が
「Bottom が行高を超えるノード」を奥行き描画へ回すため、
変えると <font size> の文字すべての描画経路が変わってしまう。

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs b/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs
index 7595e2a..dd987b0 100644
--- a/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs
+++ b/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs
@@ -149,12 +149,26 @@ class ConsoleDivPart : AConsoleDisplayNode
 					continue;
 				foreach (var part in button.StrArray)
 					if (part != null)
-						bottom = Math.Max(bottom, lineY + part.Bottom);
+						bottom = Math.Max(bottom, lineY + PartBottom(part));
 			}
 		}
 		return bottom;
 	}
 
+	#region 統合_netEmuera_fontサイズ
+	/// <summary>
+	/// ノードの下端。&lt;font size&gt; で大きくした文字は AConsoleDisplayPart.Bottom が
+	/// 設定フォントサイズを返すので、そのままだと自動サイズの div が中身より低くなり
+	/// 大きな文字が途中で切れる（ShinEraTenseiP のエンカウント表示がこれ）
+	/// </summary>
+	private static int PartBottom(AConsoleDisplayNode part)
+	{
+		if (part is ConsoleStyledString css && css.StringStyle.FontSize > 0)
+			return Math.Max(part.Bottom, css.StringStyle.FontSize);
+		return part.Bottom;
+	}
+	#endregion
+
 	private int EdgeSize(int direction)
 	{
 		int size = 0;
