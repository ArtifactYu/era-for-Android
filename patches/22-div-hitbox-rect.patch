TestChildHitbox の矩形が DrawTo とずれていたのを直す。

  * Y に枠の厚み(margin/border/padding)を足しながら高さは外枠のままだったので、
    枠のぶん下にずれていた。border_width や padding を付けた div で顕著
  * 自動サイズの div は DrawTo が中身の実寸(contentWidth/contentHeight)まで
    クリップを広げるのに、判定は行数ベースの矩形のままだった。
    行高を超える画像を入れた div は、はみ出した部分を押せなかった

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs b/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs
index 517d293..b23fa30 100644
--- a/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs
+++ b/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs
@@ -208,11 +208,20 @@ class ConsoleDivPart : AConsoleDisplayNode
 	public ConsoleButtonString TestChildHitbox(int pointX, int pointY, int relPointY)
 	{
 		ConsoleButtonString pointing = null;
-		#region EE_div各要素の修正
-		var rect = new Rectangle(PointX + xOffset, relPointY + PointY + yOffset, width, Height);
+		#region 統合_netEmuera_div当たり判定
+		//当たり判定の矩形を DrawTo と揃える。外枠がそのまま当たり判定で、
+		//枠(margin/border/padding)の内側が中身の原点。
+		//従来は Y だけ枠のぶん下げて高さは外枠のままだったので、枠の厚みぶん下にずれていた
+		int boxTop = relPointY + PointY;
+		int contentTop = boxTop + yOffset;
+		var rect = new Rectangle(PointX + xOffset, boxTop, width, Height);
+		//自動サイズのときは DrawTo が中身の実寸までクリップを広げるので、判定もそこまで広げる。
+		//行高を超える画像を入れた div は、これが無いとはみ出した部分を押せない
+		if (autoSized)
+			rect = Rectangle.Union(rect, new Rectangle(PointX + xOffset + divXOffset, contentTop, contentWidth, contentHeight));
 		#endregion
 		if (!rect.Contains(pointX, pointY)) return null;
-		relPointY = rect.Y;
+		relPointY = contentTop;
 		foreach (var line in children)
 		{
 			for (int b = 0; b < line.Buttons.Length; b++)
