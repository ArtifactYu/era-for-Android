 		StringBuilder sb = new();
 		//統合_netEmuera: width/height は省略可。省略時は中身から算出する
@@ -63,14 +65,15 @@ class ConsoleDivPart : AConsoleDisplayNode
 		#region EE_div各要素の修正
 		if (margin != null) divXOffset += margin[Direction.Left];
