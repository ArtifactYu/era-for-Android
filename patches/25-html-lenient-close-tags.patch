ShinEraTenseiP の RPG\ダンジョンアタック\SYSTEM_DUNGEON.ERB:2638 と :2679 が
<font size='300'> を </fontsize> で閉じている。EM+EE の tagAnalyze は知らない
終了タグをエラーにするため、ダンジョンでエンカウントすると
「終了タグ</fontsize>は解釈できません」で止まっていた。

.netEmuera は HTML パーサ(AngleSharp)なので、HTML の規則(any other end tag)
どおり対応する開始タグの無い終了タグは無視する。閉じ忘れたタグも文書の終わりで
自動的に閉じる。その2点に合わせ、閉じ忘れ判定からは <b>/<i>/<u>/<s> と <font> を
外した。<button> は入力の意味を持つので従来どおりエラーにする。

</div> の閉じ忘れを自動で閉じるパッチ(08)と同じ考え方。

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 Emuera/UI/Game/HtmlManager.cs | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/Emuera/UI/Game/HtmlManager.cs b/Emuera/UI/Game/HtmlManager.cs
index 81b41c4..e94ea4a 100644
--- a/Emuera/UI/Game/HtmlManager.cs
+++ b/Emuera/UI/Game/HtmlManager.cs
@@ -648,7 +648,13 @@ internal static class HtmlManager
 		//.netEmuera は AngleSharp なのでこれを許しており、</div> を <div> と打ち間違えたまま
 		//配布されているバリアントが実際にある
 		#endregion
-		if (state.CurrentButtonTag != null || state.FontStyle != FontStyle.Regular || state.FonttagList.Count > 0)
+		#region 統合_netEmuera_閉じタグ寛容化
+		//閉じ忘れた <b>/<i>/<u>/<s>/<font> は HTML と同じく末尾で自動的に閉じる。
+		//.netEmuera は AngleSharp なので閉じ忘れを許しており、ShinEraTenseiP の
+		//SYSTEM_DUNGEON.ERB は <font size='300'> を閉じないまま行を終える。
+		//<button> は入力の意味を持つので従来どおりエラーにする
+		#endregion
+		if (state.CurrentButtonTag != null)
 			throw new CodeEE(trerror.TagIsNotClosed.Text);
 		if (cssList.Count > 0)
 			buttonList.Add(cssToButton(cssList, state, console));
@@ -1065,8 +1071,14 @@ internal static class HtmlManager
 					state.CurrentDivTag = null;
 					return null;
 				#endregion
+				#region 統合_netEmuera_閉じタグ寛容化
 				default:
-					throw new CodeEE(string.Format(trerror.CanNotInterpretCloseTag.Text, tag));
+					//開いていない要素の終了タグは読み飛ばす。.netEmuera は HTML パーサ(AngleSharp)
+					//なので、HTML の規則(any other end tag)どおり対応する開始タグが無ければ無視する。
+					//ShinEraTenseiP の SYSTEM_DUNGEON.ERB:2638 が <font size='300'> を
+					//</fontsize> で閉じており、エンカウント表示がここで止まっていた
+					return null;
+				#endregion
 			}
 			//goto error;
 		}
