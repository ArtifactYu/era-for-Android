島（HTML_PRINT_ISLAND）は行に属さないので ConsoleEscapedParts に載らず、
奥行きごとの描画を通らない。島の描画は ConsoleDisplayLine.DrawTo を呼ぶだけで、
その先の ConsoleButtonString.DrawTo は div を読み飛ばすため、
島の中の <div> は当たり判定にだけ入って画面には出ていなかった。

ShinEraTenseiP は画面暗転もエンカウント表示も <div> だけの島で作る
（RPG\ダンジョンアタック\SYSTEM_DUNGEON.ERB:2626 と :2630）ので、
このままではエラーにならなくても何も出ない。入れ子の div を描くために
既にある DrawNestedDivs を島からも使えるようにして、行が直接持つ div を描く。

島の当たり判定を足したパッチ(23)の描画側にあたる。

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs | 9 +++++++++
 Emuera/UI/Game/EmueraConsole.cs                 | 6 ++++++
 2 files changed, 15 insertions(+)

diff --git a/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs b/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs
index 5d8505b..7595e2a 100644
--- a/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs
+++ b/Emuera/Runtime/Utils/EvilMask/ConsoleDivPart.cs
@@ -352,6 +352,15 @@ class ConsoleDivPart : AConsoleDisplayNode
 		graph.ResetClip();
 	}
 
+	#region 統合_netEmuera_island内div
+	/// <summary>行が直接持っている div を描く。HTML_PRINT_ISLAND のように
+	/// 奥行きごとの描画（ConsoleEscapedParts）を通らない行のためのもの</summary>
+	internal static void DrawDivsIn(Graphics graph, ConsoleDisplayLine line, int pointY, TextDrawingMode mode)
+	{
+		DrawNestedDivs(graph, line, pointY, false, false, false, mode);
+	}
+	#endregion
+
 	#region 統合_netEmuera_div入れ子
 	private static void DrawNestedDivs(Graphics graph, ConsoleDisplayLine line, int pointY, bool isSelecting, bool isFocus, bool isBackLog, TextDrawingMode mode)
 	{
diff --git a/Emuera/UI/Game/EmueraConsole.cs b/Emuera/UI/Game/EmueraConsole.cs
index 6f0b420..225b6c0 100644
--- a/Emuera/UI/Game/EmueraConsole.cs
+++ b/Emuera/UI/Game/EmueraConsole.cs
@@ -1777,6 +1777,12 @@ internal sealed partial class EmueraConsole : IDisposable
 		foreach (var element in _htmlElementList)
 		{
 			element.DrawTo(graph, y, false, false, Config.TextDrawingMode);
+			#region 統合_netEmuera_island内div
+			//ConsoleButtonString.DrawTo は div を読み飛ばし、島は ConsoleEscapedParts に
+			//載らない（＝奥行きごとの描画に入らない）ので、島の div はここで自分で描く。
+			//ShinEraTenseiP のエンカウント表示や画面暗転が <div> だけの島を出す
+			ConsoleDivPart.DrawDivsIn(graph, element, y, Config.TextDrawingMode);
+			#endregion
 			y += Config.LineHeight;
 		}
 
