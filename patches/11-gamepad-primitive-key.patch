---
 .../UI/Framework/Forms/MainWindow.GamePad.cs  | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/Emuera/UI/Framework/Forms/MainWindow.GamePad.cs b/Emuera/UI/Framework/Forms/MainWindow.GamePad.cs
index 883d57e..7306f39 100644
--- a/Emuera/UI/Framework/Forms/MainWindow.GamePad.cs
+++ b/Emuera/UI/Framework/Forms/MainWindow.GamePad.cs
@@ -45,6 +45,17 @@ namespace MinorShift.Emuera.Forms
 			if ((pressed & cfg.ScrollUp) != 0) { ScrollLogByGamePad(-10); return; }
 			if ((pressed & cfg.ScrollDown) != 0) { ScrollLogByGamePad(10); return; }
 
+			//INPUTMOUSEKEY などで生のキー入力を待っている画面では、
+			//選択カーソルではなくキーボードと同じようにキーコードを渡す。
+			//そうしないとその画面でパッドが効かなくなる
+			if (console.IsWaitingPrimitive)
+			{
+				Keys key = PrimitiveKeyFromGamePad(pressed, cfg);
+				if (key != Keys.None)
+					console.PressPrimitiveKey(key, key, Keys.None);
+				return;
+			}
+
 			if ((pressed & cfg.Cancel) != 0)
 			{
 				console.ClearSelectingButton();
@@ -65,6 +76,18 @@ namespace MinorShift.Emuera.Forms
 			if ((pressed & cfg.Down) != 0) { console.MoveSelectingButton(ButtonMoveDirection.Down); return; }
 		}
 
+		/// <summary>生キー入力待ちの画面向けに、パッドの入力をキーコードへ読み替える</summary>
+		private static Keys PrimitiveKeyFromGamePad(int pressed, GamePadConfig cfg)
+		{
+			if ((pressed & cfg.Decide) != 0) return Keys.Return;
+			if ((pressed & cfg.Cancel) != 0) return Keys.Escape;
+			if ((pressed & cfg.Left) != 0) return Keys.Left;
+			if ((pressed & cfg.Right) != 0) return Keys.Right;
+			if ((pressed & cfg.Up) != 0) return Keys.Up;
+			if ((pressed & cfg.Down) != 0) return Keys.Down;
+			return Keys.None;
+		}
+
 		/// <summary>
 		/// 決定。マウス左クリックと同じ経路に流す。
 		/// 選択中ボタンがあればその入力値を、無ければ単なる改行待ちの解除として扱う。
