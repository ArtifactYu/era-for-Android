diff --git a/Emuera/UI/Game/EmueraConsole.GamePad.cs b/Emuera/UI/Game/EmueraConsole.GamePad.cs
new file mode 100644
index 0000000..25b6aa6
--- /dev/null
+++ b/Emuera/UI/Game/EmueraConsole.GamePad.cs
@@ -0,0 +1,78 @@
+//統合_ゲームパッド対応: パッドで画面上のボタンを選ぶための処理。
+//マウスのホバー選択と同じ selectingButton を動かすので、決定はクリックと同じ経路に乗る。
+using MinorShift.Emuera.Runtime;
+using MinorShift.Emuera.UI.Game;
+using System.Collections.Generic;
+
+namespace MinorShift.Emuera.GameView;
+
+internal sealed partial class EmueraConsole
+{
+	/// <summary>
+	/// 今選べるボタンを画面の並び順（上の行から、行内は左から）で集める。
+	/// マウスの当たり判定と同じ条件を使う。
+	/// </summary>
+	private List<ConsoleButtonString> CollectSelectableButtons()
+	{
+		List<ConsoleButtonString> ret = [];
+		if (state != ConsoleState.WaitInput || !inputReq.NeedValue)
+			return ret;
+
+		bool needInteger = inputReq.InputType == InputType.IntValue || inputReq.InputType == InputType.IntButton;
+		foreach (ConsoleDisplayLine line in displayLineList)
+		{
+			foreach (ConsoleButtonString button in line.Buttons)
+			{
+				if (button == null || !button.IsButton)
+					continue;
+				if (button.Generation != lastButtonGeneration)
+					continue;
+				if (needInteger && !button.IsInteger)
+					continue;
+				ret.Add(button);
+			}
+		}
+		return ret;
+	}
+
+	/// <summary>
+	/// 選択カーソルを delta 個ずらす。未選択なら端から入る。
+	/// 動かせたら true。
+	/// </summary>
+	public bool MoveSelectingButton(int delta)
+	{
+		List<ConsoleButtonString> buttons = CollectSelectableButtons();
+		if (buttons.Count == 0)
+			return false;
+
+		int index = selectingButton != null ? buttons.IndexOf(selectingButton) : -1;
+		if (index < 0)
+			index = delta >= 0 ? 0 : buttons.Count - 1;
+		else
+		{
+			index += delta;
+			//端で止めず反対側へ回す。選択肢が少ない画面で行ったり来たりせずに済む
+			if (index < 0) index = buttons.Count - 1;
+			else if (index >= buttons.Count) index = 0;
+		}
+
+		selectingButton = buttons[index];
+		//選んだボタンが履歴に隠れていたら最新まで戻す
+		if (window.ScrollBar.Value != window.ScrollBar.Maximum)
+			window.ScrollBar.Value = window.ScrollBar.Maximum;
+		RefreshStrings(true);
+		return true;
+	}
+
+	/// <summary>選択カーソルを外す</summary>
+	public void ClearSelectingButton()
+	{
+		if (selectingButton == null)
+			return;
+		selectingButton = null;
+		RefreshStrings(true);
+	}
+
+	/// <summary>パッドで操作できる状態か</summary>
+	public bool CanUseGamePadSelection => state == ConsoleState.WaitInput && inputReq != null && inputReq.NeedValue;
+}
